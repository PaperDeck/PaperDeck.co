---
const { link } = Astro.props
---

<a
  href={link}
  target="_blank"
  rel="noreferrer"
  class="flex items-center gap-2 px-6 py-3 rounded-md border border-transparent bg-black text-white dark:bg-white dark:text-black text-sm font-medium cursor-pointer hover:bg-gray-800 dark:hover:bg-gray-200 transition-colors"
>
  <slot />
</a>
