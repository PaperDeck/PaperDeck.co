---
import "../styles/global.css"
const { title = "PaperDeck" } = Astro.props
---
<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex items-center justify-center bg-white text-black dark:bg-black dark:text-white">
    <slot />
  </body>
</html>
