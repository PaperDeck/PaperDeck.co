---
import Layout from "@/layout/Layout.astro"
import Icon from "@/components/Icon.astro"
import DownloadButton from "@/components/DownloadButton.astro"
import { releaseApiUrl } from "@/consts"

let release
if (import.meta.env.DEV) {
  // Mock response for development
  const mockRelease = {
    tag_name: "v1.0.0",
  }
  release = mockRelease
} else {
  const response = await fetch(releaseApiUrl)
  release = await response.json()
}

const latestVersion = release.tag_name
---

<Layout title="PaperDeck">
  <div class="w-full max-w-xl mx-auto p-8 flex flex-col items-center gap-6">
    <Icon />
    <h1 class="text-3xl font-semibold tracking-tight">PaperDeck</h1>
    <p>Read feeds locally. Stay open.</p>
    <p class="text-center text-zinc-500 dark:text-zinc-400">
      Latest Version: {latestVersion}
    </p>
    <DownloadButton />
  </div>
</Layout>
